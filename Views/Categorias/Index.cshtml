@model List<TechStoreMVC.Models.Categoria>

@{
    ViewData[index: "Title"] = "Categoria";
}

<h1>
    Lista de Categorias
</h1>
<div class="row g-3"></div>
<table Class="table table-striped">
    @* Tipo da tabela acima com Bootstrap*@
    <thead>
        @* Cabeçalho da tabela *@
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>Descricao</th>
            <th>Ativa</th>
        </tr>
    </thead>
    <tbody>
        @* Imagine que a cada novo produto você tivevesse que repetir isso toda a vez, sem fim.
    Por isso, usamas o foreach.
    
    O Foreach repete enquanto houver produtos existentes e, se exitir, eles serão exibidos para ti nessa tela.*@
        @foreach (var categoria in Model)
        {
            <tr>
                <td>@categoria.Id</td>
                <td>@categoria.Nome</td>
                <td>@categoria.Descricao</td>
                <td>@categoria.Ativa</td>
                <td>
                        <a asp-action="Details" asp-route-id="@categoria.Id" class="btn btn-primary btn-sm">
                            Detalhes
                        </a>

                        <a asp-action="Edit" asp-route-id="@categoria.Id" class="btn btn-warning btn-sm">
                            Editar
                        </a>

                        <a asp-action="Delete" asp-route-id="@categoria.Id" class="btn btn-danger btn-sm">
                            Excluir
                        </a>
                        <!-- Os botões serão adicionados
                             nas próximas etapas. -->
                    </td>
            </tr>
        }
    </tbody>
</table>
